-- Department
CREATE TABLE Department (
dept_id INT PRIMARY KEY AUTO_INCREMENT,
dept_name VARCHAR(80) NOT NULL UNIQUE,
hod_name VARCHAR(80) NOT NULL,
established_year INT NOT NULL
CHECK (established_year BETWEEN 1900 AND 2100)
);

-- Faculty
CREATE TABLE Faculty (
faculty_id INT PRIMARY KEY AUTO_INCREMENT,
name VARCHAR(80) NOT NULL,
dept_id INT NOT NULL,
designation VARCHAR(40) NOT NULL DEFAULT 'Assistant Professor',
email VARCHAR(120) NOT NULL UNIQUE,
join_date DATE NOT NULL,
FOREIGN KEY (dept_id)
REFERENCES Department(dept_id)
);

-- Course
CREATE TABLE Course (
course_id INT PRIMARY KEY AUTO_INCREMENT,
course_name VARCHAR(100) NOT NULL UNIQUE,
credits INT NOT NULL CHECK (credits BETWEEN 1 AND 8),
dept_id INT NOT NULL,
faculty_id INT,
FOREIGN KEY (dept_id)
REFERENCES Department(dept_id),
FOREIGN KEY (faculty_id)
REFERENCES Faculty(faculty_id)
ON DELETE SET NULL
);

-- Student
CREATE TABLE Student (
student_id INT PRIMARY KEY AUTO_INCREMENT,
name VARCHAR(80) NOT NULL,
dob DATE NOT NULL,
gender CHAR(1) NOT NULL
CHECK (gender IN ('M','F','O')),
dept_id INT NOT NULL,
email VARCHAR(120) NOT NULL UNIQUE,
admission_year INT NOT NULL
CHECK (admission_year BETWEEN 1990 AND 2100),
FOREIGN KEY (dept_id)
REFERENCES Department(dept_id)
);

-- Enrollment
CREATE TABLE Enrollment (
enroll_id INT PRIMARY KEY AUTO_INCREMENT,
student_id INT NOT NULL,
course_id INT NOT NULL,
enroll_date DATE NOT NULL DEFAULT (CURRENT_DATE),
UNIQUE (student_id, course_id),
FOREIGN KEY (student_id)
REFERENCES Student(student_id)
ON DELETE CASCADE,
FOREIGN KEY (course_id)
REFERENCES Course(course_id)
ON DELETE CASCADE
);

-- Attendance
CREATE TABLE Attendance (
att_id INT PRIMARY KEY AUTO_INCREMENT,
student_id INT NOT NULL,
course_id INT NOT NULL,
date DATE NOT NULL,
status VARCHAR(10) NOT NULL
CHECK (status IN ('Present','Absent','Leave')),
marked_by INT NOT NULL,
FOREIGN KEY (student_id)
REFERENCES Student(student_id),
FOREIGN KEY (course_id)
REFERENCES Course(course_id),
FOREIGN KEY (marked_by)
REFERENCES Faculty(faculty_id)
);

-- Exam
CREATE TABLE Exam (
exam_id INT PRIMARY KEY AUTO_INCREMENT,
course_id INT NOT NULL,
exam_date DATE NOT NULL,
max_marks INT NOT NULL
CHECK (max_marks BETWEEN 10 AND 200),
FOREIGN KEY (course_id)
REFERENCES Course(course_id)
ON DELETE CASCADE
);

-- Marks
CREATE TABLE Marks (
mark_id INT PRIMARY KEY AUTO_INCREMENT,
student_id INT NOT NULL,
exam_id INT NOT NULL,
marks_obtained INT NOT NULL
CHECK (marks_obtained BETWEEN 0 AND 200),
grade CHAR(2),
published_on DATE,
FOREIGN KEY (student_id)
REFERENCES Student(student_id)
ON DELETE CASCADE,
FOREIGN KEY (exam_id)
REFERENCES Exam(exam_id)
ON DELETE CASCADE
);

-- Fee Payment
CREATE TABLE FeePayment (
payment_id INT PRIMARY KEY AUTO_INCREMENT,
student_id INT NOT NULL,
amount DECIMAL(10,2) NOT NULL CHECK (amount > 0),
payment_date DATE NOT NULL DEFAULT (CURRENT_DATE),
mode VARCHAR(20) NOT NULL
CHECK (mode IN ('Cash','Card','Online','Cheque')),
status VARCHAR(15) NOT NULL
CHECK (status IN ('Paid','Pending','Partial')),
FOREIGN KEY (student_id)
REFERENCES Student(student_id)
ON DELETE CASCADE
);

-- Audit Table
