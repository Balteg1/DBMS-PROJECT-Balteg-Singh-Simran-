DELIMITER //

CREATE PROCEDURE sp_MarkAttendance(
IN p_student_id INT,
IN p_course_id INT,
IN p_date DATE,
IN p_status VARCHAR(10),
IN p_marked_by INT
)
BEGIN
DECLARE v_pct DECIMAL(5,2);

INSERT INTO Attendance
(student_id, course_id, date, status, marked_by)
VALUES
(p_student_id, p_course_id, p_date, p_status, p_marked_by);

SELECT ROUND(
    100.0 * SUM(
        CASE WHEN status = 'Present' THEN 1 ELSE 0 END
    ) / COUNT(*), 2
)
INTO v_pct
FROM Attendance
WHERE student_id = p_student_id
  AND course_id = p_course_id;

IF v_pct < 75 THEN
    SELECT CONCAT(
        'WARNING: Student ', p_student_id,
        ' attendance in course ', p_course_id,
        ' has fallen to ', v_pct, '%'
    ) AS warning;
END IF;
END //

DELIMITER ;

