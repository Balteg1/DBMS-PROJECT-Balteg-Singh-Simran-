payment_id INT NOT NULL,
student_id INT NOT NULL,
amount DECIMAL(10,2) NOT NULL,
action_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
action_type VARCHAR(20) NOT NULL
