s.student_id,
s.name AS student_name,
d.dept_name AS department
FROM Student s
JOIN Department d
ON s.dept_id = d.dept_id
ORDER BY s.name;
GO

-- Query 2
SELECT
c.course_name,
COUNT(e.student_id) AS enrolled_students
FROM Course c
LEFT JOIN Enrollment e
ON c.course_id = e.course_id
GROUP BY c.course_id, c.course_name
ORDER BY enrolled_students DESC;
GO

-- Query 3
SELECT
s.name AS student_name,
c.course_name,
COUNT(a.att_id) AS total_classes,
SUM(
CASE WHEN a.status='Present'
THEN 1 ELSE 0 END
) AS attended,
ROUND(
100.0 *
SUM(
CASE WHEN a.status='Present'
THEN 1 ELSE 0 END
) / COUNT(a.att_id), 2
) AS attendance_pct
FROM Student s
JOIN Enrollment e
ON s.student_id = e.student_id
JOIN Course c
ON e.course_id = c.course_id
JOIN Attendance a
ON a.student_id = s.student_id
AND a.course_id = c.course_id
GROUP BY
s.student_id,
s.name,
c.course_id,
c.course_name
ORDER BY s.name;
GO

-- Query 4
SELECT
s.student_id,
s.name,
s.email,
SUM(f.amount) AS pending_or_partial_amount
FROM Student s
JOIN FeePayment f
ON s.student_id = f.student_id
WHERE f.status IN ('Pending','Partial')
GROUP BY s.student_id, s.name, s.email;
GO

-- Query 5
SELECT
exam_id,
student_id,
marks_obtained,
rank_in_exam
FROM (
SELECT
m.exam_id,
m.student_id,
m.marks_obtained,
RANK() OVER (
PARTITION BY m.exam_id
ORDER BY m.marks_obtained DESC
) AS rank_in_exam
FROM Marks m
) ranked
WHERE rank_in_exam <= 3
ORDER BY exam_id, rank_in_exam;
GO

-- Query 6
SELECT
f.faculty_id,
f.name AS faculty_name,
f.designation,
COUNT(c.course_id) AS courses_assigned,
COALESCE(SUM(c.credits),0) AS total_credits
FROM Faculty f
LEFT JOIN Course c
ON c.faculty_id = f.faculty_id
GROUP BY
f.faculty_id,
f.name,
f.designation
ORDER BY total_credits DESC;
GO

-- Query 7
SELECT
s.student_id,
s.name,
s.email,
ROUND(
100.0 *
SUM(
CASE WHEN a.status='Present'
THEN 1 ELSE 0 END
) / COUNT(a.att_id), 2
) AS attendance_pct
FROM Student s
JOIN Attendance a
ON s.student_id = a.student_id
GROUP BY s.student_id, s.name, s.email
HAVING
ROUND(
100.0 *
SUM(
CASE WHEN a.status='Present'
THEN 1 ELSE 0 END
) / COUNT(a.att_id), 2
) < 75
ORDER BY attendance_pct;
GO

-- Query 8
SELECT
m.student_id,
s.name,
m.exam_id,
m.marks_obtained
FROM Marks m
JOIN Student s
ON m.student_id = s.student_id
WHERE m.marks_obtained > (
SELECT AVG(marks_obtained)
FROM Marks
WHERE exam_id = m.exam_id
)
ORDER BY m.exam_id, m.marks_obtained DESC;
GO
